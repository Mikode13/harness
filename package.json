{
	"name": "@mikode13/harness",
	"version": "0.0.0-development",
	"description": "Test/agent harness utility",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mikode13/harness.git"
	},
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "mikode-git-hooks install",
		"prepack": "pnpm run build",
		"build": "mikode-scripts clean dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p cli",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"dev": "pnpm --filter @mikode13/harness-cli run dev",
		"test": "vitest run --project unit --project cli",
		"test:unit": "vitest run --project unit --project cli",
		"test:unit:watch": "vitest --project unit --project cli",
		"test:coverage": "vitest run --project unit --project cli --coverage",
		"pack:check": "pnpm run build && node scripts/pack-check.mjs",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
	},
	"devDependencies": {
		"@mikode13/code-quality": "1.0.0",
		"@mikode13/cross-platform": "1.0.0",
		"@mikode13/code-style": "1.0.0",
		"@mikode13/git-hooks": "1.0.0",
		"@mikode13/tsconfig": "1.0.0",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.8.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.220",
		"@openai/codex-sdk": "^0.154.0",
		"zod": "^4.4.3"
	}
}
